{
  "expo": {
    "name": "CueVex",
    "slug": "cuevex-mobile-prototype",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cuevexprototype",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.cuevex.mobile",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "CueVex needs camera access to scan friend QR codes.",
        "NSPhotoLibraryUsageDescription": "CueVex needs photo library access so you can choose images for posts and your profile avatar."
      }
    },
    "android": {
      "package": "com.cuevex.mobile",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro"
    }
  }
}
