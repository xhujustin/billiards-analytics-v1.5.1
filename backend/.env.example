# ========================================
# 撞球分析系統 - 本機環境設定
# ========================================
# 原則：只放現場會調的值；完整預設值與型別轉換由 backend/config.py 管理。
# 修改此檔後需重啟後端才會生效。

# ========================================
# YOLO 模型與辨識門檻
# ========================================
# 相對於 backend/。目前使用 best.pt。
MODEL_PATH=yolo-weight/best.pt

# 提高可減少誤框；降低可增加漏球補抓。config.py 預設為 0.60。
CONF_THR=0.80

# ========================================
# 球桌顏色與 ROI
# ========================================
# 藍色桌布會套用 config.py 的 blue HSV preset。
TABLE_CLOTH_COLOR=blue
TABLE_MIN_AREA=100000

# 若真的需要手動鎖定 HSV，再取消下列註解；啟用後會覆蓋 TABLE_CLOTH_COLOR 與 runtime 偏好。
# HSV_LOWER=90,50,50
# HSV_UPPER=130,255,255

# ========================================
# 相機與串流
# ========================================
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=50
# 預設只掃 DSHOW/MSMF，避免 CAP_ANY 觸發 OpenCV obsensor 無效索引警告；特殊裝置才改 true。
CAMERA_ENABLE_ANY_BACKEND=false
CAMERA_EXPOSURE=-6
CAMERA_FOURCC_PRIORITY=MJPG,YUY2,YUYV

JPEG_QUALITY=70
MJPEG_QUALITY=70
MJPEG_MAX_FPS=30

# 留空使用攝影機；指定影片檔路徑時改用影片來源。
VIDEO_SOURCE=

# ========================================
# AI Coach
# ========================================
AI_COACH_ENABLED=true
AI_COACH_WS_URL=ws://localhost:8010/ws/coach
AI_COACH_API_URL=http://localhost:8002/v1/chat/completions
AI_COACH_MODEL=/home/lucian039/gemma-4-awq

# ========================================
# 開發/診斷常用開關
# ========================================
ENABLE_DEV_MODE=false
PERF_DIAGNOSTICS_ENABLED=true
COLOR_DEBUG_ENABLED=false
